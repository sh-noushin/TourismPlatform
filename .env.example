# Copy to .env before running `docker compose up`:  cp .env.example .env
#
# docker-compose.yml requires MSSQL_SA_PASSWORD and JWT_KEY and will refuse to start
# without them. The rest have working defaults.

# SQL Server rejects weak passwords: 8+ chars with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=Local!Dev!Sql!2026

# HMAC-SHA256 signing key for JWTs. Must be at least 32 characters.
# Generate one:  openssl rand -base64 48
JWT_KEY=replace-me-with-at-least-32-random-characters

# Where the browser reaches the API. Change only if you remap the api host port.
DASHBOARD_API_BASE_URL=http://localhost:5266

# Host port for the public site, and its own external URL used to build absolute
# URLs in metadata. Keep the two in sync if you remap the port.
PUBLIC_WEB_PORT=3001
PUBLIC_SITE_URL=http://localhost:3001

# Live currency rates from navasan.tech. Get a free key from their Telegram bot
# (@navasan_contact_bot); the free tier allows 120 calls a month, which is why
# the sync interval defaults to 6 hours. Leave empty to run without live rates.
NAVASAN_API_KEY=
NAVASAN_SYNC_MINUTES=360

# Seeded on first API start. Created only if the email does not already exist --
# changing the password here will NOT reset an account that is already in the database.
SUPERUSER_EMAIL=superadmin@gmail.com
SUPERUSER_PASSWORD=SuperAdmin!123
SUPERUSER_USERNAME=superadmin
